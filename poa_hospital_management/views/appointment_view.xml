<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <data>

    <!-- Search View -->
    <record id="view_poa_hospital_managementital_appointment_search" model="ir.ui.view">
        <field name="name">poa_hospital_managementital.appointment.search</field>
        <field name="model">poa_hospital_managementital.appointment</field>
        <field name="arch" type="xml"> 
            <search>
                <field name="patient_id" string="Patient Name"/>
                <field name="booking_date"/>
                <field name="booking_time"/>
                <field name="appointment_type"/>
                <field name="is_urgent"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_poa_hospital_managementital_appointment_list" model="ir.ui.view">
        <field name="name">poa_hospital_managementital.appointment.list</field>
        <field name="model">poa_hospital_managementital.appointment</field>
        <field name="arch" type="xml"> 
            <list>
                <field name="patient_id" string="Patient Name"/>
                <field name="booking_date"/>
                <field name="booking_time"/>
                <field name="appointment_type"/>
                <field name="is_urgent"/>
                <field name="fees"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_poa_hospital_managementital_appointment_form" model="ir.ui.view">
        <field name="name">poa_hospital_managementital.appointment.form</field>
        <field name="model">poa_hospital_managementital.appointment</field>
        <field name="arch" type="xml"> 
            <form>
                <header> 
                    <field name="state" widget="statusbar" options="{'clickable': 'true'}"/>
                </header>
                <sheet>
                    <group>
                        <group name="patient_details" string="Patient Details">
                            <field name="patient_id" string="Patient Name"/>
                            <field name="age"/>
                        </group>

                        <group name="appointment_details" string="Appointment Details">
                            <field name="booking_date"/>
                            <field name="booking_time"/>
                            <field name="appointment_type"/>
                            <field name="is_urgent"/>
                            <field name="fees"/>
                            <field name="description"/>
                            <field name="doctor_notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_poa_hospital_managementital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">poa_hospital_managementital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Appointment!
            </p>
        </field>
    </record>
    
    <!-- Menu Item -->
    <menuitem
        id="menu_appointment_master"
        name="Appointments"
        parent="menu_poa_hospital_managementital_root"
        action="action_poa_hospital_managementital_appointment"
        sequence="10"/>

 </data>
</odoo>
